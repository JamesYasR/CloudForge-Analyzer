{
  "name": "vtk",
  "version-semver": "9.3.0",
  "port-version": 1,
  "description": "Exact Kitware VTK 9.3.0 release built with Qt6 support (vcpkg overlay port)",
  "homepage": "https://vtk.org",
  "license": "BSD-3-Clause",
  "dependencies": [
    "double-conversion",
    "eigen3",
    "expat",
    "exprtk",
    "fast-float",
    "fmt",
    {
      "name": "freetype",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "glew",
    {
      "name": "hdf5",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "jsoncpp",
    "libjpeg-turbo",
    "liblzma",
    "libpng",
    {
      "name": "libxml2",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "lz4",
    "nlohmann-json",
    "pegtl",
    "pugixml",
    {
      "name": "tiff",
      "default-features": false
    },
    "utfcpp",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "verdict",
    "zlib"
  ],
  "features": {
    "opengl": {
      "description": "OpenGL rendering modules",
      "dependencies": [
        {
          "name": "vtk",
          "default-features": false
        }
      ]
    },
    "qt": {
      "description": "Qt6 support: vtkGUISupportQt / QVTKOpenGLNativeWidget",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "opengl",
            "sql-sqlite",
            "widgets"
          ]
        },
        {
          "name": "vtk",
          "default-features": false,
          "features": [
            "sql"
          ]
        }
      ]
    },
    "sql": {
      "description": "SQL support used by Qt helper modules",
      "dependencies": [
        {
          "name": "sqlite3",
          "features": [
            "tool"
          ]
        }
      ]
    }
  }
}
